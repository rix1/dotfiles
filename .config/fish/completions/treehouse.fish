# Completions for treehouse, generated by the binary itself on first use in a
# shell, so they follow `treehouse update` without a stale copy in this repo.
command -q treehouse; or exit
treehouse completion fish | source

# The generated script knows nothing about the pool. Add its worktrees:
# `destroy` only accepts a path, `enter`, `lease` and `return` take the name
# (the number in `treehouse status`).

# Prints "name<TAB>path<TAB>status<TAB>branch" for each worktree in this repo's pool.
function __treehouse_worktrees
    set -l json (treehouse status --json 2>/dev/null | string collect)
    or return
    for obj in (string split '},{' -- $json)
        set -l name (string match -rg '"name":"([^"]*)"' -- $obj)
        set -l path (string match -rg '"path":"([^"]*)"' -- $obj)
        test -n "$name" -a -n "$path"; or continue
        set -l wt_status (string match -rg '"status":"([^"]*)"' -- $obj)
        set -l branch (string match -rg '"branch":"([^"]*)"' -- $obj)
        test -n "$branch"; or set branch detached
        printf '%s\t%s\t%s\t%s\n' $name $path $wt_status $branch
    end
end

function __treehouse_worktree_paths
    __treehouse_worktrees | while read -l -d \t name path wt_status branch
        printf '%s\t%s\n' $path "$name: $wt_status, $branch"
    end
end

function __treehouse_worktree_names
    __treehouse_worktrees | while read -l -d \t name path wt_status branch
        printf '%s\t%s\n' $name "$wt_status, $branch"
    end
end

function __treehouse_pool_paths
    __treehouse_worktrees | while read -l -d \t name path wt_status branch
        # A worktree is <pool>/<name>/<repo>.
        printf '%s\t%s\n' (path dirname (path dirname $path)) 'the whole pool, with --all'
    end | sort -u
end

# True when the argument being completed is a worktree, not a flag.
function __treehouse_wants_worktree
    __fish_seen_subcommand_from destroy enter lease return
    and not string match -q -- '-*' (commandline -ct)
end

# For those arguments the generated script falls back to listing files in the
# current directory, which drowns the worktrees. Skip it there.
functions -c __treehouse_prepare_completions __treehouse_prepare_completions_generated
function __treehouse_prepare_completions
    __treehouse_wants_worktree; and return 1
    __treehouse_prepare_completions_generated
end

complete -c treehouse -n '__treehouse_wants_worktree && __fish_seen_subcommand_from destroy' -f -k -a '(__treehouse_pool_paths; __treehouse_worktree_paths)'
complete -c treehouse -n '__treehouse_wants_worktree && __fish_seen_subcommand_from enter lease return' -f -k -a '(__treehouse_worktree_names)'
