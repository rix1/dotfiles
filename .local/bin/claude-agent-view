#!/bin/sh
# Live, readable view of a Claude Code subagent transcript.
#
#   claude-agent-view FILE.jsonl   follow a subagent transcript in this terminal
#   claude-agent-view --hook       SubagentStart hook: follow the new subagent in a
#                                  background Rex tab, one tab per Claude session
#                                  with a split per subagent (reads hook JSON on
#                                  stdin; does nothing outside Rex)
set -eu

follow() {
	tail -n +1 -F "$1" 2>/dev/null | jq --unbuffered -r '
	  select(.type == "assistant" or .type == "user") | .message.content
	  | if type == "string" then empty else .[] end
	  | if .type == "text" then "\u001b[1m▍\u001b[0m " + .text
	    elif .type == "tool_use" then "\u001b[36m→ \(.name)\u001b[0m "
	      + ((.input.description // .input.file_path // .input.command // .input.pattern // "") | tostring | .[0:160])
	    elif .type == "tool_result" then "\u001b[2m  ↳ "
	      + ((.content | if type == "array" then (map(.text? // "") | join(" ")) else tostring end) | gsub("\n"; " ") | .[0:140])
	      + "\u001b[0m"
	    else empty end'
}

hook() {
	[ -n "${REX_SESSION:-}" ] || exit 0
	command -v rex >/dev/null 2>&1 || exit 0
	input=$(cat)
	agent_id=$(printf '%s' "$input" | jq -r '.agent_id // empty')
	parent=$(printf '%s' "$input" | jq -r '.transcript_path // empty')
	agent_type=$(printf '%s' "$input" | jq -r '.agent_type // "agent"')
	[ -n "$agent_id" ] && [ -n "$parent" ] || exit 0

	dir="${parent%.jsonl}/subagents"
	transcript="$dir/agent-$agent_id.jsonl"

	# The meta file carries the Agent call's description; it can land a moment
	# after the hook fires, so wait briefly before falling back to the type.
	name=""
	tries=0
	while [ $tries -lt 20 ]; do
		if [ -f "$dir/agent-$agent_id.meta.json" ]; then
			name=$(jq -r '.description // empty' "$dir/agent-$agent_id.meta.json")
			break
		fi
		tries=$((tries + 1))
		sleep 0.1
	done
	[ -n "$name" ] || name="$agent_type"

	# Subagents started together fire their hooks at once; only one may create the tab.
	mkdir -p "$dir"
	lock="$dir/.rex-lock"
	tries=0
	while ! mkdir "$lock" 2>/dev/null; do
		tries=$((tries + 1))
		[ $tries -lt 100 ] || break
		sleep 0.1
	done
	trap 'rmdir "$lock" 2>/dev/null || true' EXIT

	state="$dir/.rex-window"
	window=""
	[ -f "$state" ] && window=$(cat "$state")
	if [ -n "$window" ] && layout=$(rex window inspect "$window" -s "$REX_SESSION" --json 2>/dev/null); then
		# Split the largest pane, side by side while it is wide and stacked once it is
		# not, so the tab fills as a grid instead of ever-thinner columns.
		set -- $(printf '%s' "$layout" | jq -r '
		  [.layers[] | select(.kind == "tiled") | .layout | .. | objects
		   | select(has("block_id") and has("rect"))
		   | {id: .block_id, w: .rect[2], h: .rect[3]}]
		  | max_by(.w * .h)
		  | "\(.id) \(if .w * 1.8 > .h * 1.6 then "right" else "below" end)"')
		rex split -s "$REX_SESSION" -w "$window" -b "$1" --split="$2" --focus=false --keep-open \
			--label "$name" -- "$0" "$transcript" >/dev/null
	else
		session=$(basename "${parent%.jsonl}")
		created=$(rex window new -s "$REX_SESSION" "agenter ${session%%-*}" --focus=false --keep-open --json \
			-- "$0" "$transcript")
		printf '%s' "$created" | jq -r '.window_id' >"$state"
		rex block rename "$(printf '%s' "$created" | jq -r '.block_ids[0]')" "$name" -s "$REX_SESSION" >/dev/null || true
	fi
}

case "${1:-}" in
--hook) hook ;;
"" | -h | --help) sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//' ;;
*) follow "$1" ;;
esac
