#!/usr/bin/env bash
# dotfiles-setup — idempotent per-machine provisioning for the dotfiles.
#
#   dotfiles-setup             check every step, fix what is missing
#   dotfiles-setup --dry-run   only report
#
# Run it after `dotfiles-sync` (which does so automatically) or any time; every
# step looks before it acts, so a second run is a no-op. The order matters on a
# fresh machine: fish sources starship, direnv, fnm etc. on every start, so the
# Brewfile is installed before fish becomes the login shell. Steps:
#
#   homebrew    present (stops here if not: install it first, see ~/.github/README.md)
#   brewfile    everything in ~/.config/Brewfile installed (never upgrades or removes)
#   shell       fish >= 4 in /etc/shells and set as the login shell (sudo, chsh)
#   fisher      plugins installed as listed in ~/.config/fish/fish_plugins
#   tmux        tpm cloned, plugins from tmux.conf installed
#   fonts       ~/.config/fonts/*.otf installed into ~/Library/Fonts
#   ghostty     font-codepoint-map line for the LLM logo glyphs
#   starship    llm-conversation-count built from ~/.config/src (rustc), else the Python fallback
#   claude      dotfiles skill hooks (UserPromptSubmit, Stop) registered in ~/.claude/settings.json

set -uo pipefail

DRY=0
case ${1:-} in
  --dry-run) DRY=1 ;;
  -h|--help) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  "") ;;
  *) echo "dotfiles-setup: unknown option: $1" >&2; exit 2 ;;
esac

H=${HOME_OVERRIDE:-$HOME}
CFG=$H/.config
changed=0 newshell=0

hdr()  { printf '\n%s\n' "$*"; }
ok()   { printf '  ✓ %s\n' "$*"; }
skip() { printf '  · %s\n' "$*"; }
act()  { changed=1; if (( DRY )); then printf '  → would %s\n' "$*"; else printf '  → %s\n' "$*"; fi; }
run()  { (( DRY )) || "$@"; }

# ---------------------------------------------------------------- homebrew
hdr "homebrew"
# A fresh zsh has no brew on PATH until `brew shellenv` runs; don't depend on it.
if ! command -v brew >/dev/null && [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv bash)"
fi
if command -v brew >/dev/null; then
  ok "$(brew --version | head -1)"
else
  skip "Homebrew is missing and every step below needs it."
  skip "Install it first (~/.github/README.md, step 2), then rerun."
  exit 1
fi

# ---------------------------------------------------------------- brewfile
hdr "brewfile"
BREWFILE=$CFG/Brewfile
if [[ ! -f $BREWFILE ]]; then
  skip "no ~/.config/Brewfile"
elif HOMEBREW_NO_AUTO_UPDATE=1 brew bundle check --no-upgrade --file="$BREWFILE" >/dev/null 2>&1; then
  ok "everything in ~/.config/Brewfile is installed"
else
  HOMEBREW_NO_AUTO_UPDATE=1 brew bundle check --no-upgrade --verbose --file="$BREWFILE" 2>&1 \
    | sed -n 's/^→ \(.*\) needs to be installed.*/\1/p' | while read -r l; do skip "missing: $l"; done
  act "brew bundle install --file ~/.config/Brewfile"
  run brew bundle install --no-upgrade --file="$BREWFILE"
fi

# ---------------------------------------------------------------- shell
hdr "login shell"
FISH=$(command -v fish || true)
if [[ -z $FISH ]]; then
  skip "fish not installed (it is in the Brewfile; rerun after brew bundle succeeds)"
else
  v=$(fish --version | awk '{print $NF}')
  if (( ${v%%.*} >= 4 )); then ok "fish $v"
  else act "upgrade fish $v → 4.x (brew)"; run brew upgrade fish; fi

  # Both changes need a password prompt, so only offer them in a terminal.
  if grep -qxF "$FISH" /etc/shells; then ok "$FISH listed in /etc/shells"
  elif [[ -t 0 ]]; then act "add $FISH to /etc/shells (sudo)"; run sudo sh -c "echo '$FISH' >> /etc/shells"
  else skip "$FISH not in /etc/shells; run in a terminal: echo $FISH | sudo tee -a /etc/shells"; fi

  login=$(dscl . -read "/Users/$(id -un)" UserShell 2>/dev/null | awk '{print $2}')
  if [[ $login == "$FISH" ]]; then ok "login shell is fish"
  elif [[ -t 0 ]] && grep -qxF "$FISH" /etc/shells; then
    act "chsh -s $FISH (asks for your password)"; run chsh -s "$FISH" && newshell=1
  else skip "login shell is ${login:-unknown}; run in a terminal: chsh -s $FISH"; fi
fi

# ---------------------------------------------------------------- fisher
hdr "fisher plugins"
PLUGINS=$CFG/fish/fish_plugins
# The plugin files are tracked, so on a machine where fisher has no record of
# them (empty $_fisher_plugins) a plain `fisher update` treats every plugin as
# a new install, refuses to overwrite the checked-out files, and then deletes
# fish_plugins because nothing got installed. Recording the listed plugins as
# installed first makes it an update, which rewrites the files in place.
FISHER_ADOPT='for p in (string match -rv "^\s*(#|\$)" < $__fish_config_dir/fish_plugins)
  contains -- (string lower -- $p) (string lower -- $_fisher_plugins); or set -U --append _fisher_plugins $p
end; fisher update'
restored=0
if [[ ! -f $PLUGINS ]] && git --git-dir="$H/.dotfiles" cat-file -e HEAD:.config/fish/fish_plugins 2>/dev/null; then
  act "restore fish_plugins (an earlier failed fisher run deletes it)"
  run git --git-dir="$H/.dotfiles" --work-tree="$H" checkout -- .config/fish/fish_plugins
  restored=1
fi
if [[ ! -f $PLUGINS ]] && ! (( restored )); then
  skip "no ~/.config/fish/fish_plugins"
elif ! command -v fish >/dev/null || ! fish -c 'type -q fisher' 2>/dev/null; then
  skip "fisher not available yet (it ships in the dotfiles; open a new fish shell and rerun)"
else
  lc() { tr '[:upper:]' '[:lower:]' | sort; }
  want=$(git --git-dir="$H/.dotfiles" show HEAD:.config/fish/fish_plugins 2>/dev/null | lc)
  [[ -f $PLUGINS ]] && want=$(lc < "$PLUGINS")
  have=$(fish -c 'fisher list' 2>/dev/null | lc)
  if [[ $want == "$have" ]]; then ok "in sync with fish_plugins ($(wc -l <<<"$want" | tr -d ' ') plugins)"
  else act "fisher update (adopts the checked-out plugin files, installs the rest)"; run fish -c "$FISHER_ADOPT"; fi
fi

# ---------------------------------------------------------------- tmux
hdr "tmux plugins"
TPM=$CFG/tmux/plugins/tpm
if command -v tmux >/dev/null; then
  if [[ -d $TPM ]]; then ok "tpm present"
  else act "clone tpm"; run git clone -q https://github.com/tmux-plugins/tpm "$TPM"; fi
  missing=0
  for p in $(sed -n "s/^set -g @plugin 'tmux-plugins\/\([^']*\)'.*/\1/p" "$CFG/tmux/tmux.conf" 2>/dev/null); do
    [[ $p == tpm ]] && continue
    if [[ -d $CFG/tmux/plugins/$p ]]; then ok "$p"; else missing=1; fi
  done
  if (( missing )); then act "install tmux plugins listed in tmux.conf"; run "$TPM/bin/install_plugins" >/dev/null; fi
else
  skip "tmux not installed (brew install tmux)"
fi

# ---------------------------------------------------------------- fonts
hdr "fonts"
shopt -s nullglob
for src in "$CFG"/fonts/*.otf "$CFG"/fonts/*.ttf; do
  dst=$H/Library/Fonts/$(basename "$src")
  if cmp -s "$src" "$dst"; then ok "$(basename "$src") installed"
  else act "install $(basename "$src") → ~/Library/Fonts"; run mkdir -p "$H/Library/Fonts"; run cp "$src" "$dst"; fi
done
shopt -u nullglob

# ---------------------------------------------------------------- ghostty
hdr "ghostty"
GC="$H/Library/Application Support/com.mitchellh.ghostty/config"
LINE='font-codepoint-map = U+F8000-U+F80FF=LLM Logos'
if [[ -d /Applications/Ghostty.app ]] || command -v ghostty >/dev/null; then
  if [[ -f $GC ]] && grep -qxF "$LINE" "$GC"; then ok "font-codepoint-map for LLM Logos"
  else
    act "append font-codepoint-map to Ghostty config"
    if ! (( DRY )); then
      mkdir -p "$(dirname "$GC")"
      printf '\n# LLM logo glyphs for the Starship conversation counter (added by dotfiles-setup)\n%s\n' "$LINE" >> "$GC"
    fi
  fi
else
  skip "Ghostty not installed"
fi

# ---------------------------------------------------------------- starship counter
hdr "llm-conversation-count"
BIN=$CFG/bin/llm-conversation-count
SRC=$CFG/src/llm-conversation-count.rs
if [[ -x $BIN && ! -L $BIN && $BIN -nt $SRC ]]; then ok "binary newer than source"
elif command -v rustc >/dev/null; then act "build with rustc -O"; run rustc -O "$SRC" -o "$BIN" 2>/dev/null
elif [[ -x $BIN ]]; then skip "no rustc; keeping the existing $(basename "$(readlink "$BIN" || echo binary)")"
else act "no rustc: link the Python fallback"; run ln -sf llm-conversation-count.py "$BIN"; fi

# ---------------------------------------------------------------- claude code hooks
hdr "claude code hooks"
SETTINGS=$H/.claude/settings.json
HOOK=$H/.claude/skills/dotfiles/scripts/hook
if [[ ! -x $HOOK ]]; then skip "no dotfiles skill at ~/.claude/skills/dotfiles"
elif ! command -v jq >/dev/null; then skip "jq missing; register the hooks by hand (see ~/.claude/skills/dotfiles/SKILL.md)"
elif [[ -f $SETTINGS ]] && ! jq -e . "$SETTINGS" >/dev/null 2>&1; then skip "~/.claude/settings.json is not valid JSON; fix it first"
else
  if [[ ! -f $SETTINGS ]]; then
    act "create ~/.claude/settings.json"
    if ! (( DRY )); then mkdir -p "$(dirname "$SETTINGS")"; echo '{}' > "$SETTINGS"; fi
  fi
  for pair in UserPromptSubmit:prompt Stop:stop; do
    ev=${pair%%:*} sub=${pair##*:}
    cmd="h=\$HOME/.claude/skills/dotfiles/scripts/hook; [ -x \"\$h\" ] && exec \"\$h\" $sub; exit 0"
    if [[ -f $SETTINGS ]] && jq -e --arg ev "$ev" \
         '[.hooks[$ev][]?.hooks[]?.command // "" | select(contains("skills/dotfiles/scripts/hook"))] | length > 0' \
         "$SETTINGS" >/dev/null 2>&1; then
      ok "$ev hook registered"
    else
      act "register $ev hook in ~/.claude/settings.json"
      if ! (( DRY )); then
        tmp=$(mktemp) && jq --arg ev "$ev" --arg cmd "$cmd" \
          '.hooks //= {} | .hooks[$ev] //= [] | .hooks[$ev] += [{hooks: [{type: "command", command: $cmd, timeout: 20}]}]' \
          "$SETTINGS" > "$tmp" && mv "$tmp" "$SETTINGS"
      fi
    fi
  done
fi

echo
if (( changed )); then
  (( DRY )) && echo "dry run: changes pending" || echo "done: some steps changed things (open a new terminal for fonts and fish)"
  if (( newshell )); then echo "login shell is now fish: quit this terminal and open Ghostty before installing anything else"; fi
else
  echo "nothing to do"
fi
